{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asnad68/NOTHING/blob/main/schema/procedure.schema.json",
  "title": "NOTHING Verification Procedure",
  "description": "A versioned, named procedure that defines how a NOTHING claim may be evaluated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "title",
    "status",
    "method_class",
    "allowed_results",
    "requires_evidence",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^NOTHING-[A-Z0-9-]+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "ACTIVE",
        "DEPRECATED",
        "RETIRED"
      ]
    },
    "method_class": {
      "type": "string",
      "enum": [
        "source_check",
        "domain_control",
        "authorization_check",
        "identity_attribute_check",
        "other"
      ]
    },
    "allowed_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "VERIFIED",
          "SOURCE-VERIFIED",
          "NOT-VERIFIED",
          "INCONCLUSIVE",
          "REVOKED"
        ]
      }
    },
    "requires_evidence": {
      "type": "boolean"
    },
    "evidence_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "web_page",
          "public_record",
          "authorized_document",
          "registry_record",
          "domain_control",
          "statement",
          "other"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "description"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^STEP-[0-9]{2}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "published_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "deprecated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "retired_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "DEPRECATED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deprecated_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RETIRED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "retired_at"
        ]
      }
    }
  ]
}
