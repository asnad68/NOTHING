{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asnad68/NOTHING/blob/main/schema/verification-event.schema.json",
  "title": "NOTHING Verification Event",
  "description": "An auditable event describing how a claim was evaluated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "version",
    "occurred_at",
    "subject",
    "claim_id",
    "procedure",
    "result"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^VER-[0-9]{6}$"
    },
    "version": {
      "type": "string",
      "const": "0.1"
    },
    "occurred_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|z|[+-](0[0-9]|1[0-9]|2[0-3]):[0-5][0-9])$"
    },
    "subject": {
      "type": "string",
      "pattern": "^NTH-[0-9]{6}$"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^CLM-[0-9]{6}$"
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "automated",
            "human",
            "hybrid"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVD-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "SOURCE-VERIFIED",
            "NOT-VERIFIED",
            "INCONCLUSIVE",
            "REVOKED"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^VER-[0-9]{6}$"
    },
    "metadata": {
      "type": "object"
    }
  }
}
