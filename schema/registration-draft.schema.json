{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/asnad68/NOTHING/blob/main/schema/registration-draft.schema.json",
  "title": "NOTHING Registration Draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "type", "website", "domains", "channels", "description"],
  "properties": {
    "name": {"type": "string", "minLength": 1, "maxLength": 180},
    "type": {"type": "string", "enum": ["business", "brand", "digital_channel"]},
    "website": {"type": "string", "maxLength": 500},
    "domains": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 253}},
    "channels": {"type": "array", "maxItems": 50, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "description": {"type": "string", "maxLength": 2000}
  }
}
