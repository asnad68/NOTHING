# NOTHING production deployment contract.
# Never put real credentials in this file or in source control.

NOTHING_STORAGE_BACKEND=postgres
NOTHING_AUTH_MODE=oidc-jwt
NOTHING_TENANCY_MODE=single-tenant
NOTHING_API_HOST=0.0.0.0
NOTHING_API_PORT=8080

# Inject from the deployment secret manager; do not commit the value.
NOTHING_POSTGRES_DSN=

# OIDC access-token validation. All URLs must use HTTPS.
NOTHING_AUTH_ISSUER=
NOTHING_AUTH_AUDIENCE=
NOTHING_AUTH_JWKS_URI=
NOTHING_AUTH_REQUIRED_SCOPE=nothing:ingest
NOTHING_AUTH_ALLOWED_ALGORITHMS=RS256
NOTHING_AUTH_CLOCK_SKEW_SECONDS=60
NOTHING_AUTH_JWKS_CACHE_SECONDS=300
NOTHING_AUTH_JWKS_TIMEOUT_SECONDS=5

# Trust proxy headers only when the gateway overwrites them and direct
# application access is blocked.
NOTHING_TRUST_PROXY_HEADERS=false

# Bounded database pool.
NOTHING_POSTGRES_POOL_MIN_SIZE=2
NOTHING_POSTGRES_POOL_MAX_SIZE=10
NOTHING_POSTGRES_POOL_TIMEOUT_SECONDS=10
NOTHING_POSTGRES_STATEMENT_TIMEOUT_MS=15000
NOTHING_POSTGRES_LOCK_TIMEOUT_MS=5000
NOTHING_POSTGRES_SERIALIZATION_RETRIES=4
NOTHING_POSTGRES_RETRY_BACKOFF_SECONDS=0.05

# Operational identity for database observability.
NOTHING_POSTGRES_APPLICATION_NAME=nothing-api

# Public/read and write rate limits are per-instance reference limits.
# Production gateways must enforce distributed limits.
NOTHING_RATE_WINDOW_SECONDS=60
NOTHING_RATE_LIMIT_MAX_REQUESTS=120
NOTHING_INGESTION_RATE_WINDOW_SECONDS=60
NOTHING_INGESTION_RATE_LIMIT_MAX_REQUESTS=30


# Authenticated billing API. Keep billing permission separate from protocol ingestion.
NOTHING_BILLING_REQUIRED_SCOPE=nothing:billing
NOTHING_BILLING_TOKEN=
NOTHING_BILLING_ACTOR=authenticated-billing
NOTHING_BILLING_MAX_BODY_BYTES=65536
NOTHING_BILLING_RATE_WINDOW_SECONDS=60
NOTHING_BILLING_RATE_LIMIT_MAX_REQUESTS=20

# Receive-only XRPL observation worker.
NOTHING_XRPL_RPC_URL=https://xrplcluster.com/
NOTHING_XRPL_ACCOUNT=
NOTHING_PAYMENT_POLL_SECONDS=5
NOTHING_PAYMENT_ACTOR=xrpl-payment-worker
NOTHING_XRPL_WORKER_NAME=xrpl-payment-worker
NOTHING_XRPL_DISCOVERY_LIMIT=200
NOTHING_XRPL_MAX_DISCOVERY_PAGES=20
