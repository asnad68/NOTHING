{
  "manifest_version": 3,
  "name": "NOTHING — Business Identity",
  "version": "0.1.0",
  "description": "Register and verify business identities with NOTHING from your browser.",
  "action": {
    "default_title": "NOTHING",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "minimum_chrome_version": "120",
  "homepage_url": "https://github.com/asnad68/NOTHING"
}
